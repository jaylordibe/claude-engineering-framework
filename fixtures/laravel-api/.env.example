APP_NAME=API
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

SERVICE_NAME="app"

DB_CONNECTION=mysql
DB_HOST="${SERVICE_NAME}-db"
DB_PORT=3306
DB_DATABASE="${SERVICE_NAME}_local"
DB_USERNAME="${SERVICE_NAME}"
DB_PASSWORD=

# The suite runs against a separate live database, not an in-memory one.
TEST_DB_CONNECTION=mysql
TEST_DB_HOST="${SERVICE_NAME}-db-test"
TEST_DB_DATABASE="${SERVICE_NAME}_test"

QUEUE_CONNECTION=redis
REDIS_HOST="${SERVICE_NAME}-redis"
REDIS_PORT=6379

CACHE_DRIVER=file
SESSION_DRIVER=file
FILESYSTEM_DISK=local

RATE_LIMIT_PUBLIC=30
RATE_LIMIT_SENSITIVE=5
RATE_LIMIT_API_PER_TOKEN=120
