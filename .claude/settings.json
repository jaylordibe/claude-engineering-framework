{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(node tests/:*)",
      "PowerShell(node tests/:*)",
      "Bash(claude plugin validate:*)",
      "PowerShell(claude plugin validate:*)"
    ]
  },
  "enabledPlugins": {
    "engineering-framework@jaylordibe": true
  },
  "extraKnownMarketplaces": {
    "jaylordibe": {
      "source": {
        "source": "github",
        "repo": "jaylordibe/claude-engineering-framework"
      },
      "autoUpdate": true
    }
  }
}
