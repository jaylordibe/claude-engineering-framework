#!/usr/bin/env bash
#
# himoa-doctor — audit the contract between the installed Himoa framework
# and the repository it is running in.
#
# The framework validates itself in its own CI. This validates the other half:
# whether THIS repository supplies what the framework needs, and whether the
# guarantees the framework's documentation makes are actually in force here.
#
# It is deliberately read-only and never edits anything. Run it directly, or
# through /himoa:framework-doctor for an interpreted report.
#
# Exit codes: 0 all checks pass (warnings allowed), 1 at least one FAIL,
# 2 usage error.

set -uo pipefail

project_directory=${CLAUDE_PROJECT_DIR:-$PWD}
# Claude Code sets CLAUDE_PLUGIN_ROOT; a human running bin/himoa-doctor from a
# checkout does not. Falling back to the script's own location keeps the
# reference-file checks working in both, rather than silently skipping them
# and reporting a clean bill of health it never actually verified.
plugin_root=${CLAUDE_PLUGIN_ROOT:-}
if [ -z "$plugin_root" ]; then
  plugin_root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
fi
strict=false

while [ "$#" -gt 0 ]; do
  case "$1" in
    --path)
      shift
      [ "$#" -gt 0 ] || {
        printf 'himoa-doctor: --path needs a directory\n' >&2
        exit 2
      }
      project_directory=$1
      ;;
    --strict) strict=true ;;
    -h | --help)
      cat <<'USAGE'
Usage: himoa-doctor [--path <repository>] [--strict]

Audits a repository against the Himoa framework's repository contract.

  --path <dir>  Repository to audit (default: $CLAUDE_PROJECT_DIR, else $PWD)
  --strict      Treat warnings as failures
USAGE
      exit 0
      ;;
    *)
      printf 'himoa-doctor: unknown argument %s\n' "$1" >&2
      exit 2
      ;;
  esac
  shift
done

failures=0
warnings=0

pass() { printf 'PASS  %s\n' "$1"; }
warn() {
  printf 'WARN  %s\n' "$1"
  warnings=$((warnings + 1))
}
fail() {
  printf 'FAIL  %s\n' "$1"
  failures=$((failures + 1))
}
note() { printf '      %s\n' "$1"; }

printf 'Himoa — repository contract audit\n'
printf 'Repository: %s\n\n' "$project_directory"

if [ ! -d "$project_directory" ]; then
  fail "no such directory: $project_directory"
  exit 1
fi

# ---------------------------------------------------------------------------
# 1. Repository truth — AGENTS.md (or CLAUDE.md), the one mandatory artefact
# ---------------------------------------------------------------------------
#
# Repository truth lives in AGENTS.md, the neutral home every coding agent
# reads; Claude Code reads it through a CLAUDE.md that imports it (@AGENTS.md).
# AGENTS.md is therefore the truth document when it is present, and a legacy
# CLAUDE.md-only repository still audits unchanged. Checking a CLAUDE.md that is
# only an importer would wrongly report the truth sections missing, which is why
# the resolution prefers AGENTS.md.

truth_file=""
truth_name=""
if [ -r "${project_directory}/AGENTS.md" ]; then
  truth_file="${project_directory}/AGENTS.md"; truth_name="AGENTS.md"
elif [ -r "${project_directory}/CLAUDE.md" ]; then
  truth_file="${project_directory}/CLAUDE.md"; truth_name="CLAUDE.md"
fi

if [ -z "$truth_file" ]; then
  fail 'Repository truth is missing: neither AGENTS.md nor CLAUDE.md.'
  note 'The framework owns methodology and this repository owns truth. Without'
  note 'one, every agent infers the stack. Start from reference/AGENTS.md.template'
  note '(read by every agent; CLAUDE.md imports it for Claude Code).'
else
  pass "$truth_name exists."

  if grep -qiE '^#{1,3}[[:space:]]*(project|stack|overview)\b' "$truth_file"; then
    pass "$truth_name declares what this system is."
  else
    warn "$truth_name has no Project/Stack section."
    note 'Agents fall back to inference for language, runtime and data stores.'
  fi

  if grep -qiE '^#{1,3}[[:space:]]*(canonical commands|commands|verification)\b' "$truth_file"; then
    pass "$truth_name declares canonical commands."
  else
    warn "$truth_name declares no canonical commands."
    note 'The validation gate cannot produce evidence it did not discover a'
    note 'command for, and will report BLOCKED rather than guess.'
  fi

  # High-risk paths are optional - most repositories are adequately classified
  # from the diff - so an absent section is a note, not a warning. What is NOT
  # optional is that the gates can find it if it exists.
  if grep -qiE '^#{1,3}[[:space:]]*high-risk paths\b' "$truth_file"; then
    pass "$truth_name declares high-risk paths."
    note 'The design and review gates read this section and take the higher'
    note 'risk tier for a change touching one of those paths. It is advisory'
    note 'guidance to an agent: it shapes ceremony, and it blocks no edit.'
  fi

  if grep -qiE '^#{1,3}[[:space:]]*consumers\b' "$truth_file"; then
    if grep -qF '_(none declared yet)_' "$truth_file"; then
      fail 'The Consumers table still holds the template placeholder.'
      note 'An unfilled table and a deliberately empty one are'
      note 'indistinguishable, so every contract change reports "no consumers"'
      note 'and cross-repository breakage ships silently. List the consumers,'
      note 'or write "(none - internal only)" and say why.'
    else
      pass 'Consumers table is filled in.'
    fi
  else
    warn "$truth_name has no Consumers section."
    note 'Contract changes will not identify who breaks.'
  fi

  # Match the placeholder FORM, not a copy of three of the template's strings.
  # `_(none - internal only)_` is the template's own way of saying a section is
  # DELIBERATELY empty, so it is a filled-in answer rather than a placeholder.
  placeholders=$(grep -nE '_\([^)]+\)_' "$truth_file" | grep -viE '_\(none' || true)
  if [ -n "$placeholders" ]; then
    placeholder_count=$(printf '%s\n' "$placeholders" | wc -l | tr -d ' ')
    fail "$truth_name still contains $placeholder_count unfilled template placeholder(s)."
    note 'A placeholder reads to a later agent exactly like a completed'
    note 'section, and agents treat this file as evidence. Fill it in, or'
    note 'delete the heading, or write "_(none - ...)_" to say the emptiness'
    note 'is deliberate.'
    printf '%s\n' "$placeholders" | head -5 | while IFS= read -r placeholder_line; do
      note "  $placeholder_line"
    done
  fi
fi

# ---------------------------------------------------------------------------
# 3. The project's dependency declaration
#
# This audits the same three keys `himoa-install-settings` writes, and deliberately
# does its own small read rather than calling that script: the doctor is
# read-only, and a doctor that shells out to the installer to find out what the
# installer would do is one refactor away from doing it.
#
# Nothing here is a failure. A repository that registers the marketplace by
# hand on every machine is configured differently, not incorrectly.
# ---------------------------------------------------------------------------

project_settings="${project_directory}/.claude/settings.json"
declaration="${plugin_root}/reference/marketplace-declaration.json"

if command -v jq >/dev/null 2>&1 && [ -r "$declaration" ]; then
  marketplace_name=$(jq -r '.marketplace' "$declaration")
  plugin_identifier="$(jq -r '.plugin' "$declaration")@${marketplace_name}"

  if [ ! -r "$project_settings" ]; then
    warn 'This repository does not declare the Himoa framework.'
    note 'Run /himoa:framework-install to add the marketplace'
    note 'and plugin declaration to .claude/settings.json. Without it every'
    note 'collaborator registers the marketplace by hand on every machine.'
  elif ! jq -e 'type == "object"' "$project_settings" >/dev/null 2>&1; then
    fail '.claude/settings.json is not a JSON object.'
    note 'Claude Code cannot read this repository settings at all, so its'
    note 'permissions, hooks and plugin declarations are all inert.'
  else
    if jq -e --arg name "$marketplace_name" \
      '.extraKnownMarketplaces[$name].source' "$project_settings" >/dev/null 2>&1; then
      pass "Declares the ${marketplace_name} marketplace."
    else
      warn "Does not declare the ${marketplace_name} marketplace."
      note 'Collaborators run /plugin marketplace add by hand until it does.'
    fi

    if [ "$(jq -r --arg id "$plugin_identifier" '.enabledPlugins[$id]' "$project_settings")" = 'true' ]; then
      pass "Enables ${plugin_identifier} for this project."
      note 'Each collaborator still installs the plugin once on their own'
      note 'machine; project settings enable a plugin, they never install it.'
    else
      warn "Does not enable ${plugin_identifier} for this project."
    fi

    # A declaration with no auto-update is the quiet failure: everything reads
    # as configured, and the repository never receives a corrected standard,
    # because nothing here records a framework version that could look stale.
    case "$(jq -r --arg name "$marketplace_name" \
      '.extraKnownMarketplaces[$name].autoUpdate' "$project_settings")" in
      true) pass 'Auto-update is on, so releases arrive without an update command.' ;;
      false)
        pass 'Auto-update is off, as this project set it.'
        note 'Releases are adopted here with /plugin marketplace update, then'
        note '/plugin update. Nothing reports when a new one exists.'
        ;;
      *)
        warn 'The marketplace entry does not state autoUpdate.'
        note 'Third-party marketplaces default to off, so this repository will'
        note 'not receive a corrected standard until someone runs both update'
        note 'commands by hand — and nothing records a framework version here'
        note 'that could look stale. Re-run framework-install to set it, or'
        note 'set it deliberately to false.'
        ;;
    esac

    # Added in 2.2.0. A repository configured by an earlier version has a
    # complete-looking declaration and no way to know this key is missing: the
    # panel is simply empty for a whole run, which reads as the pipeline being
    # stuck rather than as a setting nobody wrote. Nothing else reports it.
    case "$(jq -r '.env.CLAUDE_CODE_ENABLE_TODO_TOOLS' "$project_settings")" in
      1) pass 'The task panel is on, so a work-item run shows which stage is live.' ;;
      null)
        warn 'env.CLAUDE_CODE_ENABLE_TODO_TOOLS is not set here.'
        note 'Current models are not given the task tools unless a session opts'
        note 'in, so a work-item run ticks no stages while it works and the'
        note 'panel stays empty. Re-run framework-install to set it, or run it'
        note 'with --no-task-tools if that is deliberate.'
        ;;
      *)
        pass 'The task panel setting is stated by this project. Left as it is.'
        ;;
    esac
  fi
fi

# ---------------------------------------------------------------------------
# 4. Leftovers from a pre-plugin installation
# ---------------------------------------------------------------------------

# `.claude/skills/` is deliberately absent from this list: repository-owned
# playbooks belong there and are expected.
for legacy in agents standards templates hooks; do
  legacy_path="${project_directory}/.claude/${legacy}"
  [ -d "$legacy_path" ] || continue

  warn ".claude/${legacy}/ still exists alongside the plugin."
  note 'Project definitions override same-named plugin ones, so the plugin'
  note 'version never takes effect while these remain. If they were copied'
  note 'from an earlier framework, delete them; if they are genuinely'
  note 'repository-specific, rename them so the override is deliberate rather'
  note 'than accidental.'
done

# ---------------------------------------------------------------------------
# Verdict
# ---------------------------------------------------------------------------

printf '\n'
if [ "$failures" -gt 0 ]; then
  printf 'FAIL — %d failure(s), %d warning(s).\n' "$failures" "$warnings"
  exit 1
fi

if [ "$warnings" -gt 0 ] && [ "$strict" = true ]; then
  printf 'FAIL — %d warning(s), strict mode.\n' "$warnings"
  exit 1
fi

printf 'PASS — %d warning(s).\n' "$warnings"
exit 0
