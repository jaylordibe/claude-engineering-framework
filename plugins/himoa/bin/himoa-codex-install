#!/usr/bin/env bash
#
# himoa-codex-install — install Himoa's Codex adapter into user-level locations.
# The logic is shared with the Cursor installer; see lib/himoa-adapter-install.sh
# for what it writes, the $HOME boundary, and why it is separate from
# himoa-install-settings (which is project-only and touches nothing in $HOME).
set -euo pipefail
HIMOA_HOST="codex"
BIN_DIR=$(cd "$(dirname "$0")" && pwd)
export HIMOA_HOST BIN_DIR
# shellcheck source=lib/himoa-adapter-install.sh
. "$BIN_DIR/lib/himoa-adapter-install.sh"
himoa_adapter_main "$@"
