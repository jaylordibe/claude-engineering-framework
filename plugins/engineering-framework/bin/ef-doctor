#!/usr/bin/env bash
#
# ef-doctor — audit the contract between the installed engineering framework
# and the repository it is running in.
#
# The framework validates itself in its own CI. This validates the other half:
# whether THIS repository supplies what the framework needs, and whether the
# guarantees the framework's documentation makes are actually in force here.
#
# It is deliberately read-only and never edits anything. Run it directly, or
# through /engineering-framework:framework-doctor for an interpreted report.
#
# Exit codes: 0 all checks pass (warnings allowed), 1 at least one FAIL,
# 2 usage error.

set -uo pipefail

project_directory=${CLAUDE_PROJECT_DIR:-$PWD}
# Claude Code sets CLAUDE_PLUGIN_ROOT; a human running bin/ef-doctor from a
# checkout does not. Falling back to the script's own location keeps the
# reference-file checks working in both, rather than silently skipping them
# and reporting a clean bill of health it never actually verified.
plugin_root=${CLAUDE_PLUGIN_ROOT:-}
if [ -z "$plugin_root" ]; then
  plugin_root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
fi
strict=false

while [ "$#" -gt 0 ]; do
  case "$1" in
    --path)
      shift
      [ "$#" -gt 0 ] || {
        printf 'ef-doctor: --path needs a directory\n' >&2
        exit 2
      }
      project_directory=$1
      ;;
    --strict) strict=true ;;
    -h | --help)
      cat <<'USAGE'
Usage: ef-doctor [--path <repository>] [--strict]

Audits a repository against the engineering framework's repository contract.

  --path <dir>  Repository to audit (default: $CLAUDE_PROJECT_DIR, else $PWD)
  --strict      Treat warnings as failures
USAGE
      exit 0
      ;;
    *)
      printf 'ef-doctor: unknown argument %s\n' "$1" >&2
      exit 2
      ;;
  esac
  shift
done

failures=0
warnings=0

pass() { printf 'PASS  %s\n' "$1"; }
warn() {
  printf 'WARN  %s\n' "$1"
  warnings=$((warnings + 1))
}
fail() {
  printf 'FAIL  %s\n' "$1"
  failures=$((failures + 1))
}
note() { printf '      %s\n' "$1"; }

printf 'Engineering framework — repository contract audit\n'
printf 'Repository: %s\n\n' "$project_directory"

if [ ! -d "$project_directory" ]; then
  fail "no such directory: $project_directory"
  exit 1
fi

# ---------------------------------------------------------------------------
# 1. CLAUDE.md — the one mandatory artefact
# ---------------------------------------------------------------------------

claude_md="${project_directory}/CLAUDE.md"

if [ ! -r "$claude_md" ]; then
  fail 'CLAUDE.md is missing.'
  note 'The framework owns methodology and this repository owns truth. Without'
  note 'CLAUDE.md there is no statement of truth, so every agent is left'
  note 'inferring the stack. Start from reference/CLAUDE.md.template.'
else
  pass 'CLAUDE.md exists.'

  if grep -qiE '^#{1,3}[[:space:]]*(project|stack|overview)\b' "$claude_md"; then
    pass 'CLAUDE.md declares what this system is.'
  else
    warn 'CLAUDE.md has no Project/Stack section.'
    note 'Agents fall back to inference for language, runtime and data stores.'
  fi

  if grep -qiE '^#{1,3}[[:space:]]*(canonical commands|commands|verification)\b' "$claude_md"; then
    pass 'CLAUDE.md declares canonical commands.'
  else
    warn 'CLAUDE.md declares no canonical commands.'
    note 'The validation gate cannot produce evidence it did not discover a'
    note 'command for, and will report BLOCKED rather than guess.'
  fi

  if grep -qiE '^#{1,3}[[:space:]]*consumers\b' "$claude_md"; then
    if grep -qF '_(none declared yet)_' "$claude_md"; then
      fail 'The Consumers table still holds the template placeholder.'
      note 'An unfilled table and a deliberately empty one are'
      note 'indistinguishable, so every contract change reports "no consumers"'
      note 'and cross-repository breakage ships silently. List the consumers,'
      note 'or write "(none - internal only)" and say why.'
    else
      pass 'Consumers table is filled in.'
    fi
  else
    warn 'CLAUDE.md has no Consumers section.'
    note 'Contract changes will not identify who breaks.'
  fi

  # Match the placeholder FORM, not a copy of three of the template's strings.
  # The string list missed the Cross-cutting conventions placeholders, which are
  # exactly what gate-implement sends every change to read — so an authorization
  # contract that is still a parenthesis passed clean.
  # `_(none - internal only)_` is the template's own way of saying a section is
  # DELIBERATELY empty, so it is a filled-in answer rather than a placeholder.
  # That distinction is the whole reason the marker exists.
  placeholders=$(grep -nE '_\([^)]+\)_' "$claude_md" | grep -viE '_\(none' || true)
  if [ -n "$placeholders" ]; then
    placeholder_count=$(printf '%s\n' "$placeholders" | wc -l | tr -d ' ')
    fail "CLAUDE.md still contains $placeholder_count unfilled template placeholder(s)."
    note 'A placeholder reads to a later agent exactly like a completed'
    note 'section, and agents treat this file as evidence. Fill it in, or'
    note 'delete the heading, or write "_(none - ...)_" to say the emptiness'
    note 'is deliberate.'
    printf '%s\n' "$placeholders" | head -5 | while IFS= read -r placeholder_line; do
      note "  $placeholder_line"
    done
  fi
fi

# ---------------------------------------------------------------------------
# 3. Repository policy file
# ---------------------------------------------------------------------------

repo_config="${project_directory}/.claude/engineering-framework.json"

if [ ! -r "$repo_config" ]; then
  warn 'No .claude/engineering-framework.json; framework defaults apply.'
  note 'That is a valid choice. Add one to declare this repository canonical'
  note 'commands, so the validation gate runs them rather than inferring, and'
  note 'its high-risk paths, so the design and review gates raise the tier.'
elif command -v jq >/dev/null 2>&1; then
  if ! jq -e '.' "$repo_config" >/dev/null 2>&1; then
    fail '.claude/engineering-framework.json is not valid JSON.'
    note 'The gates fall back to inference, so commands and risk paths you'
    note 'believe are declared are not being read.'
  elif ! jq -e 'type == "object"' "$repo_config" >/dev/null 2>&1; then
    # Valid JSON of the wrong shape used to make every later query error to
    # stderr while the audit still reported PASS.
    fail '.claude/engineering-framework.json is valid JSON but is not an object.'
    note 'The gates ignore it entirely and fall back to inference.'
  else
    pass '.claude/engineering-framework.json is valid JSON.'

    unknown=$(jq -r '
      keys - ["$schema","frameworkVersion","commands","risk"]
      | join(", ")' "$repo_config")
    if [ -n "$unknown" ]; then
      warn "Unrecognised keys ignored by the framework: $unknown"
      note 'Permission and guard keys were removed in 1.0.0. The framework no'
      note 'longer ships permission rules or hooks that gate commands, so'
      note 'protectedCommands, protectedPaths and the policy switches no longer'
      note 'do anything. Permissions belong to this repository and its owner.'
    fi

    # The two keys a repository sets and then has no way to confirm are in
    # force, because nothing else reports them back.
    high_risk_count=$(jq -r '((.risk // {}).highRiskPaths // []) | length' "$repo_config")
    if [ "$high_risk_count" -gt 0 ]; then
      pass "risk.highRiskPaths declares $high_risk_count path pattern(s)."
      note 'The design and review gates read this and take the higher risk tier'
      note 'for a change touching one. It is advisory guidance to an agent, not'
      note 'a hook: it shapes ceremony, and it does not block an edit.'
    fi

    declared_commands=$(jq -r '(.commands // {}) | keys | join(", ")' "$repo_config")
    if [ -n "$declared_commands" ] && [ "$declared_commands" != '' ]; then
      pass "commands declares: $declared_commands"
      note 'The validation gate prefers these over anything it infers. A gate'
      note 'with no command declared here falls through to CLAUDE.md, the'
      note 'manifest scripts, then CI.'
    fi

    if [ -n "$plugin_root" ] && [ -r "${plugin_root}/.claude-plugin/plugin.json" ]; then
      installed_version=$(jq -r '.version // "unknown"' "${plugin_root}/.claude-plugin/plugin.json")
      contract_version=$(jq -r '.frameworkVersion // ""' "$repo_config")
      if [ -n "$contract_version" ] && [ "$contract_version" != "$installed_version" ]; then
        installed_major=${installed_version%%.*}
        contract_major=${contract_version%%.*}
        if [ "$installed_major" != "$contract_major" ]; then
          fail "Framework major version changed: contract $contract_version, installed $installed_version."
          note 'A major bump means the workflow contract changed. Read the'
          note 'upgrade note in the framework CHANGELOG before continuing.'
        else
          note "Framework $installed_version installed; contract written against $contract_version."
        fi
      fi
    fi
  fi
fi

# ---------------------------------------------------------------------------
# 4. Leftovers from a pre-plugin installation
# ---------------------------------------------------------------------------

# `.claude/skills/` is deliberately absent from this list: repository-owned
# playbooks belong there and are expected.
for legacy in agents standards templates hooks; do
  legacy_path="${project_directory}/.claude/${legacy}"
  [ -d "$legacy_path" ] || continue

  warn ".claude/${legacy}/ still exists alongside the plugin."
  note 'Project definitions override same-named plugin ones, so the plugin'
  note 'version never takes effect while these remain. If they were copied'
  note 'from an earlier framework, delete them; if they are genuinely'
  note 'repository-specific, rename them so the override is deliberate rather'
  note 'than accidental.'
done

# ---------------------------------------------------------------------------
# Verdict
# ---------------------------------------------------------------------------

printf '\n'
if [ "$failures" -gt 0 ]; then
  printf 'FAIL — %d failure(s), %d warning(s).\n' "$failures" "$warnings"
  exit 1
fi

if [ "$warnings" -gt 0 ] && [ "$strict" = true ]; then
  printf 'FAIL — %d warning(s), strict mode.\n' "$warnings"
  exit 1
fi

printf 'PASS — %d warning(s).\n' "$warnings"
exit 0
